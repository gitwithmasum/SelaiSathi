# ========================================================
# সেলাই সাথী (SelaiSathi) - Backend Configuration Example
# ========================================================

# App
PORT=5000
NODE_ENV=development
APP_NAME=SelaiSathi
APP_URL=http://localhost:5000
PUBLIC_TRACK_URL_BASE=https://selaisathi.com/track

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/selaisathi?schema=public"

# Authentication (JWT)
JWT_SECRET="selaisathi-super-secret-jwt-key-change-in-production-2026"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"
OTP_EXPIRY_MINUTES=5

# SMS Gateway Configuration
# Options: CONSOLE (for local dev) | GREENWEB | REVE
SMS_PROVIDER=CONSOLE

# Greenweb BD SMS (If SMS_PROVIDER=GREENWEB)
GREENWEB_SMS_TOKEN=""

# Reve Systems SMS (If SMS_PROVIDER=REVE)
REVE_SMS_API_KEY=""
REVE_SMS_SECRET_KEY=""
REVE_SMS_CALLER_ID="SelaiSathi"

# MFS Payment Gateways (bKash & Nagad)
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v2.0"
BKASH_APP_KEY="sandbox_app_key"
BKASH_APP_SECRET="sandbox_app_secret"
BKASH_USERNAME="sandbox_username"
BKASH_PASSWORD="sandbox_password"

NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"
NAGAD_MERCHANT_ID="sandbox_merchant"
NAGAD_PUBLIC_KEY="sandbox_pub_key"
NAGAD_PRIVATE_KEY="sandbox_priv_key"

# CORS
CORS_ORIGIN="*"
