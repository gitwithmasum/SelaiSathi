# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/selaisathi_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="selaisathi_access_secret_super_secure_key_12345"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="selaisathi_refresh_secret_super_secure_key_67890"
JWT_REFRESH_EXPIRES_IN="30d"

# SMS Gateway Configuration
# Options: CONSOLE, GREENWEB, REVE, MIMSMS, SSL_WIRELESS
SMS_PROVIDER="CONSOLE"
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID="SelaiSathi"

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# File Upload / Storage (Cloudinary or S3/R2)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
