datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------
enum Language {
  bn
  en
}

enum Role {
  TAILOR
  CUSTOMER
  WORKER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MeasurementUnit {
  INCH
  CM
}

enum OrderPriority {
  NORMAL
  URGENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  READY_FOR_TRIAL
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ItemStage {
  FABRIC_RECEIVED
  CUTTING
  STITCHING
  FINISHING_IRONING
  TRIAL
  READY
  DELIVERED
  CANCELLED
}

enum FabricSource {
  CUSTOMER
  SHOP
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK
  OTHER
}

enum PaymentType {
  ADVANCE
  PARTIAL
  FINAL
  REFUND
}

enum WorkerSkill {
  CUTTING_MASTER
  SEWING_OPERATOR
  IRON_FINISHER
  BUTTON_HANDWORK
  ALL_ROUNDER
}

enum WorkerPaymentType {
  WAGE
  ADVANCE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  MODIFIED
}

enum ChatMessageType {
  TEXT
  IMAGE
  VOICE
  SYSTEM
}

enum NotificationChannel {
  PUSH
  SMS
  BOTH
}

enum SubscriptionTier {
  FREE
  PRO_MONTHLY
  PRO_YEARLY
}

// -------------------------------------------------------------
// AUTH & USERS
// -------------------------------------------------------------
model User {
  id              String            @id @default(uuid()) @db.Uuid
  phone           String            @unique @db.VarChar(15) // Format: +8801XXXXXXXXX
  name            String?           @db.VarChar(100)
  avatarUrl       String?
  language        Language          @default(bn)
  fcmToken        String?
  isActive        Boolean           @default(true)
  lastLoginAt     DateTime?
  roles           Role[]            @default([CUSTOMER])
  currentRole     Role              @default(CUSTOMER)
  
  tailorProfile   TailorProfile?
  customerProfile CustomerProfile?
  workerProfile   Worker?
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  sentMessages    ChatMessage[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([phone])
}

model OtpRequest {
  id              String            @id @default(uuid()) @db.Uuid
  phone           String            @db.VarChar(15)
  otpHash         String            @db.VarChar(255)
  expiresAt       DateTime
  attempts        Int               @default(0)
  isUsed          Boolean           @default(false)
  createdAt       DateTime          @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String            @unique
  deviceInfo      String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())

  @@index([userId])
}

// -------------------------------------------------------------
// PROFILES
// -------------------------------------------------------------
model TailorProfile {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @unique @db.Uuid
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName            String            @db.VarChar(150)
  shopCode            String            @unique @db.VarChar(20) // e.g. DHK-1024
  address             String            @db.Text
  latitude            Float?
  longitude           Float?
  openingHours        Json?             // e.g. { "open": "10:00", "close": "22:00", "closedOn": ["Friday"] }
  logoUrl             String?
  dailyOrderLimit     Int               @default(15)
  rushMode            Boolean           @default(false)
  ratingAvg           Decimal           @default(0.0) @db.Decimal(3, 2)
  ratingCount         Int               @default(0)

  subscriptionTier    SubscriptionTier  @default(FREE)
  smsCreditsRemaining Int               @default(30)
  subscriptionEndAt   DateTime?

  tailorCustomers     TailorCustomer[]
  garmentTypes        GarmentType[]
  orders              Order[]
  payments            Payment[]
  expenses            Expense[]
  workers             Worker[]
  trialSlots          TrialSlot[]
  holidays            Holiday[]
  galleryItems        GalleryItem[]
  reviews             Review[]
  orderRequests       OrderRequest[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([shopCode])
}

model CustomerProfile {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String?           @unique @db.Uuid
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone           String            @unique @db.VarChar(15)
  name            String            @db.VarChar(100)
  gender          Gender?
  address         String?           @db.Text

  tailorLinks     TailorCustomer[]
  orders          Order[]
  orderRequests   OrderRequest[]
  trialBookings   TrialBooking[]
  favorites       Favorite[]
  reviews         Review[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([phone])
}

model TailorCustomer {
  id              String            @id @default(uuid()) @db.Uuid
  tailorId        String            @db.Uuid
  tailor          TailorProfile     @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  customerId      String            @db.Uuid
  customer        CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag             String?           @db.VarChar(50) // REGULAR, VIP, RISK
  notes           String?           @db.Text
  totalDue        Decimal           @default(0.0) @db.Decimal(12, 2)

  measurements    Measurement[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([tailorId, customerId])
  @@index([tailorId])
}

// -------------------------------------------------------------
// MEASUREMENTS (ডিজিটাল মাপের খাতা)
// -------------------------------------------------------------
model GarmentType {
  id              String            @id @default(uuid()) @db.Uuid
  tailorId        String?           @db.Uuid // null = Global System Presets
  tailor          TailorProfile?    @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  nameBn          String            @db.VarChar(100)
  nameEn          String            @db.VarChar(100)
  icon            String?
  fields          Json              // [{ key: "length", labelBn: "ঝুল", unit: "inch", min: 20, max: 60 }]
  styleOptions    Json?             // [{ category: "Collar", options: ["Mandarin", "Shirt", "Band"] }]
  isDefault       Boolean           @default(false)

  measurements    Measurement[]
  orderItems      OrderItem[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tailorId])
}

model Measurement {
  id                String          @id @default(uuid()) @db.Uuid
  tailorCustomerId  String          @db.Uuid
  tailorCustomer    TailorCustomer  @relation(fields: [tailorCustomerId], references: [id], onDelete: Cascade)
  garmentTypeId     String          @db.Uuid
  garmentType       GarmentType     @relation(fields: [garmentTypeId], references: [id])
  values            Json            // { "length": 42.5, "chest": 38.0, ... }
  unit              MeasurementUnit @default(INCH)
  note              String?         @db.Text
  photoUrls         String[]
  version           Int             @default(1)
  isCurrent         Boolean         @default(true)
  takenAt           DateTime        @default(now())

  orderItems        OrderItem[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tailorCustomerId, garmentTypeId, isCurrent])
}

// -------------------------------------------------------------
// ORDERS & ITEMS
// -------------------------------------------------------------
model Order {
  id                    String          @id @default(uuid()) @db.Uuid
  orderNo               String          @unique @db.VarChar(30) // e.g. SS-2026-0001
  tailorId              String          @db.Uuid
  tailor                TailorProfile   @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  customerId            String          @db.Uuid
  customer              CustomerProfile @relation(fields: [customerId], references: [id])
  status                OrderStatus     @default(PENDING)
  priority              OrderPriority   @default(NORMAL)
  
  deliveryDate          DateTime
  originalDeliveryDate  DateTime
  delayReason           String?         @db.Text
  
  totalPrice            Decimal         @db.Decimal(12, 2)
  advancePaid           Decimal         @default(0.0) @db.Decimal(12, 2)
  discount              Decimal         @default(0.0) @db.Decimal(12, 2)
  notes                 String?         @db.Text
  
  trackingToken         String          @unique @db.VarChar(64)
  fabricTagCode         String?         @db.VarChar(20)

  items                 OrderItem[]
  payments              Payment[]
  changeRequests        ChangeRequest[]
  chatMessages          ChatMessage[]
  trialBookings         TrialBooking[]
  review                Review?

  deliveredAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([tailorId, status, deliveryDate])
  @@index([customerId])
  @@index([trackingToken])
}

model OrderItem {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @db.Uuid
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  garmentTypeId       String          @db.Uuid
  garmentType         GarmentType     @relation(fields: [garmentTypeId], references: [id])
  measurementId       String?         @db.Uuid
  measurement         Measurement?    @relation(fields: [measurementId], references: [id])
  
  quantity            Int             @default(1)
  price               Decimal         @db.Decimal(12, 2)
  fabricSource        FabricSource    @default(CUSTOMER)
  designNotes         String?         @db.Text
  referencePhotoUrls  String[]
  selectedStyles      Json?
  
  stage               ItemStage       @default(FABRIC_RECEIVED)
  assignedWorkerId    String?         @db.Uuid
  assignedWorker      Worker?         @relation(fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  pieceRate           Decimal?        @db.Decimal(12, 2)

  stageHistory        OrderStageHistory[]
  changeRequests      ChangeRequest[]
  workerReworks       WorkerRework[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([orderId])
  @@index([assignedWorkerId])
}

model OrderStageHistory {
  id              String            @id @default(uuid()) @db.Uuid
  orderItemId     String            @db.Uuid
  orderItem       OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  fromStage       ItemStage
  toStage         ItemStage
  changedById     String            @db.Uuid
  changedAt       DateTime          @default(now())
  note            String?           @db.Text

  @@index([orderItemId])
}

model OrderRequest {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  customer        CustomerProfile   @relation(fields: [customerId], references: [id])
  tailorId        String            @db.Uuid
  tailor          TailorProfile     @relation(fields: [tailorId], references: [id])
  details         Json
  photoUrls       String[]
  preferredDate   DateTime?
  status          RequestStatus     @default(PENDING)
  rejectionReason String?           @db.Text

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tailorId, status])
}

model ChangeRequest {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @db.Uuid
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     String?           @db.Uuid
  orderItem       OrderItem?        @relation(fields: [orderItemId], references: [id])
  message         String            @db.Text
  status          RequestStatus     @default(PENDING)
  createdById     String            @db.Uuid

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([orderId])
}

// -------------------------------------------------------------
// PAYMENTS & EXPENSES
// -------------------------------------------------------------
model Payment {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @db.Uuid
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tailorId        String            @db.Uuid
  tailor          TailorProfile     @relation(fields: [tailorId], references: [id])
  amount          Decimal           @db.Decimal(12, 2)
  method          PaymentMethod     @default(CASH)
  type            PaymentType       @default(ADVANCE)
  trxId           String?           @db.VarChar(100)
  note            String?           @db.Text
  paidAt          DateTime          @default(now())

  createdAt       DateTime          @default(now())

  @@index([orderId])
  @@index([tailorId, paidAt])
}

model Expense {
  id              String            @id @default(uuid()) @db.Uuid
  tailorId        String            @db.Uuid
  tailor          TailorProfile     @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  category        String            @db.VarChar(100)
  amount          Decimal           @db.Decimal(12, 2)
  note            String?           @db.Text
  spentAt         DateTime          @default(now())

  createdAt       DateTime          @default(now())

  @@index([tailorId, spentAt])
}

// -------------------------------------------------------------
// WORKERS / KARIGOR
// -------------------------------------------------------------
model Worker {
  id              String            @id @default(uuid()) @db.Uuid
  tailorId        String            @db.Uuid
  tailor          TailorProfile     @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  userId          String?           @unique @db.Uuid
  user            User?             @relation(fields: [userId], references: [id])
  name            String            @db.VarChar(100)
  phone           String            @db.VarChar(15)
  skill           WorkerSkill       @default(SEWING_OPERATOR)
  isActive        Boolean           @default(true)

  assignedItems   OrderItem[]
  payments        WorkerPayment[]
  reworks         WorkerRework[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tailorId])
}

model WorkerPayment {
  id              String            @id @default(uuid()) @db.Uuid
  workerId        String            @db.Uuid
  worker          Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  amount          Decimal           @db.Decimal(12, 2)
  type            WorkerPaymentType @default(WAGE)
  periodStart     DateTime?
  periodEnd       DateTime?
  note            String?           @db.Text
  paidAt          DateTime          @default(now())

  createdAt       DateTime          @default(now())

  @@index([workerId])
}

model WorkerRework {
  id              String            @id @default(uuid()) @db.Uuid
  workerId        String            @db.Uuid
  worker          Worker            @relation(fields: [workerId], references: [id])
  orderItemId     String            @db.Uuid
  orderItem       OrderItem         @relation(fields: [orderItemId], references: [id])
  reason          String            @db.Text
  isWorkerFault   Boolean           @default(true)
  deductionAmount Decimal           @default(0.0) @db.Decimal(12, 2)
  resolvedAt      DateTime?

  createdAt       DateTime          @default(now())
}

// -------------------------------------------------------------
// TRIAL SLOTS & CALENDAR
// -------------------------------------------------------------
model TrialSlot {
  id              String            @id @default(uuid()) @db.Uuid
  tailorId        String            @db.Uuid
  tailor          TailorProfile     @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  endsAt          DateTime
  isBooked        Boolean           @default(false)

  booking         TrialBooking?

  createdAt       DateTime          @default(now())

  @@index([tailorId, startsAt])
}

model TrialBooking {
  id              String            @id @default(uuid()) @db.Uuid
  slotId          String            @unique @db.Uuid
  slot            TrialSlot         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  orderId         String            @db.Uuid
  order           Order             @relation(fields: [orderId], references: [id])
  customerId      String            @db.Uuid
  customer        CustomerProfile   @relation(fields: [customerId], references: [id])
  status          RequestStatus     @default(PENDING)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Holiday {
  id              String            @id @default(uuid()) @db.Uuid
  tailorId        String            @db.Uuid
  tailor          TailorProfile     @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  date            DateTime          @db.Date
  reason          String?           @db.VarChar(150)

  createdAt       DateTime          @default(now())

  @@unique([tailorId, date])
}

// -------------------------------------------------------------
// CHAT & NOTIFICATIONS
// -------------------------------------------------------------
model ChatMessage {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @db.Uuid
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId        String            @db.Uuid
  sender          User              @relation(fields: [senderId], references: [id])
  type            ChatMessageType   @default(TEXT)
  body            String?           @db.Text
  mediaUrl        String?
  durationSec     Int?
  readAt          DateTime?

  createdAt       DateTime          @default(now())

  @@index([orderId, createdAt])
}

model Notification {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String              @db.VarChar(200)
  body            String              @db.Text
  type            String              @db.VarChar(50)
  data            Json?
  isRead          Boolean             @default(false)
  sentVia         NotificationChannel @default(PUSH)

  createdAt       DateTime            @default(now())

  @@index([userId, isRead])
}

model SmsLog {
  id              String            @id @default(uuid()) @db.Uuid
  phone           String            @db.VarChar(15)
  purpose         String            @db.VarChar(50)
  provider        String            @db.VarChar(50)
  status          String            @db.VarChar(30)
  cost            Decimal           @default(0.0) @db.Decimal(5, 2)
  createdAt       DateTime          @default(now())

  @@index([phone, createdAt])
}

// -------------------------------------------------------------
// GALLERY & REVIEWS
// -------------------------------------------------------------
model GalleryItem {
  id              String            @id @default(uuid()) @db.Uuid
  tailorId        String            @db.Uuid
  tailor          TailorProfile     @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  imageUrl        String
  category        String            @db.VarChar(50)
  caption         String?           @db.Text

  favorites       Favorite[]

  createdAt       DateTime          @default(now())

  @@index([tailorId, category])
}

model Favorite {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  customer        CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  galleryItemId   String            @db.Uuid
  galleryItem     GalleryItem       @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)

  createdAt       DateTime          @default(now())

  @@unique([customerId, galleryItemId])
}

model Review {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @unique @db.Uuid
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String            @db.Uuid
  customer        CustomerProfile   @relation(fields: [customerId], references: [id])
  tailorId        String            @db.Uuid
  tailor          TailorProfile     @relation(fields: [tailorId], references: [id])
  rating          Int
  comment         String?           @db.Text
  tailorReply     String?           @db.Text

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tailorId, rating])
}
